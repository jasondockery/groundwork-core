# Disk cleanup thresholds. disk-cleanup.sh sources this file. Change a value here
# and in docs/disk-cleanup.md together. The GROUNDWORK_DISK_* variable named beside
# a value overrides it for one run.

# Warn when less of the home volume is free than this. APFS and btrfs slow down and
# updates start failing well before the disk is full.
# Override: GROUNDWORK_DISK_LOW_FREE_PERCENT
DC_LOW_FREE_PERCENT=15

# Clean npm's cache only above this. A small cache saves real download time and
# costs little, so it stays. 3 GiB is "a few GB".
# Override: GROUNDWORK_DISK_NPM_CLEAN_MIB
DC_NPM_CACHE_CLEAN_MIB=3072

# Remove Docker build cache unused for longer than this. A week keeps what active
# work reuses from day to day.
DC_DOCKER_BUILD_CACHE_AGE=168h

# How many folders each report list shows.
DC_TOP_FOLDERS=10

# How long one cleanup command may run. A large prune can take minutes.
# Override: GROUNDWORK_DISK_STEP_DEADLINE_SECONDS
DC_STEP_DEADLINE_SECONDS=900

# How long one read-only query may run. These answer in seconds when healthy.
# Override: GROUNDWORK_DISK_OBSERVE_DEADLINE_SECONDS
DC_OBSERVE_DEADLINE_SECONDS=60

# How long the folder scan may run. The report shows what it measured by then and
# says it is incomplete.
# Override: GROUNDWORK_DISK_REPORT_DEADLINE_SECONDS
DC_REPORT_DEADLINE_SECONDS=120

# How many folders the scan measures at once. Four finish a home folder in useful
# time without taking over the disk, and each runs at low priority.
DC_SCAN_JOBS=4

# How long one question waits. No answer in time means no.
# Override: GROUNDWORK_DISK_PROMPT_DEADLINE_SECONDS
DC_PROMPT_DEADLINE_SECONDS=300

# How often a slow step says it is still running.
DC_HEARTBEAT_SECONDS=30
